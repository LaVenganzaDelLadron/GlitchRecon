# Provider selection: groq (default) or ollama
LLM_PROVIDER=groq

# Groq settings
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60
GROQ_REASONING_EFFORT=low

# AI report size limits; chosen to remain under Groq's 8,000 TPM tier.
AI_MAX_PROMPT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=800

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=60
